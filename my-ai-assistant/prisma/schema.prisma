generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum MessageRole {
  USER
  ASSISTANT
  SYSTEM
}

enum FileProcessingStatus {
  PROCESSING
  READY
  FAILED
}

model Conversation {
  id            String         @id
  userId        String         @default("anonymous")
  title         String         @default("New chat")
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  messages      Message[]
  uploadedFiles  UploadedFile[]

  @@index([userId, updatedAt])
}

model Message {
  id                 String       @id @default(cuid())
  conversationId     String
  userId             String       @default("anonymous")
  role               MessageRole
  content            String       @default("")
  attachmentKind     String?
  attachmentName     String?
  attachmentMimeType String?
  attachmentStatus   String?
  uploadedFileId     String?
  metadata           Json?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  conversation Conversation  @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  uploadedFile UploadedFile? @relation(fields: [uploadedFileId], references: [id], onDelete: SetNull)

  @@index([conversationId, createdAt])
  @@index([uploadedFileId])
}

model UploadedFile {
  id             String               @id @default(cuid())
  conversationId  String
  userId          String               @default("anonymous")
  originalName    String
  mimeType        String
  fileSize        Int
  pageCount       Int?
  extractedText   String?              @db.Text
  status          FileProcessingStatus @default(PROCESSING)
  errorMessage    String?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  conversation Conversation   @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  chunks       DocumentChunk[]
  messages     Message[]

  @@index([conversationId, userId])
  @@index([status])
}

model DocumentChunk {
  id             String      @id @default(cuid())
  uploadedFileId  String
  conversationId  String
  userId          String      @default("anonymous")
  pageNumber      Int?
  chunkIndex      Int
  text            String      @db.Text
  embedding       Unsupported("vector")
  createdAt       DateTime    @default(now())

  uploadedFile UploadedFile @relation(fields: [uploadedFileId], references: [id], onDelete: Cascade)

  @@index([conversationId, uploadedFileId])
  @@index([uploadedFileId, chunkIndex])
}